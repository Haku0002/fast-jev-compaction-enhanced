{
  "name": "fast-jev-compaction",
  "version": "0.8.3",
  "description": "Tool-call compaction for Claude Code and OpenAI API agents, with Codex export adapters and optional retrieval.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Haku0002/fast-jev-compaction-enhanced.git"
  },
  "bin": { "fast-jev-compact": "./dist/cli.js" },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "retrieval/memory-shelf/*.py",
    "retrieval/memory-shelf/README.md",
    "retrieval/memory-shelf/requirements.txt",
    "retrieval/memory-shelf/*LICENSE*.txt",
    "retrieval/memory-shelf/benchmarks/*.json",
    "retrieval/memory-shelf/benchmarks/*.md",
    "retrieval/memory-shelf/benchmarks/*LICENSE*.txt"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:hooks",
    "test": "vitest run",
    "demo": "tsx examples/demo.ts",
    "calibrate": "tsx examples/calibrate.ts",
    "typecheck:hooks": "tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate .claude-plugin/plugin.json",
    "primitives": "tsx examples/primitives.ts",
    "evaluate": "tsx examples/evaluate.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
